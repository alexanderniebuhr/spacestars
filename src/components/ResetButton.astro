<button
	type="button"
	id="reset"
	class="flex items-center justify-center rounded-full border border-slate-400/15 bg-slate-800/60 px-5 py-3 text-sm font-medium text-white transition-all duration-200 ease-out hover:scale-105 hover:bg-indigo-500/30 hover:shadow-[0_0_14px_rgba(99,102,241,0.4)] active:scale-95"
>
	Reset
</button>

<script>
	import { actions } from "astro:actions";

	const button = document.getElementById("reset");
	button?.addEventListener("click", async () => {
		await actions.reset();
	});
</script>
