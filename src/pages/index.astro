---
export const prerender = true;

import Astronauts from "../components/Astronauts.astro";
import BackgroundImage from "../components/BackgroundImage.astro";
import StickerToolbar from "../components/StickerToolbar.astro";
import "../styles/global.css";
---

<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1">
		<meta name="generator" content={Astro.generator}>
		<style is:inline>
			@media (prefers-reduced-motion: no-preference) {
				@view-transition {
					navigation: auto;
				}
			}
		</style>

		<link rel="sitemap" href="/sitemap-index.xml">
	</head>
	<body class="relative min-h-screen overflow-hidden bg-[#070529] text-white">
		<BackgroundImage />
		<div class="relative z-10">
			<Astronauts server:defer />
			<StickerToolbar />
		</div>
	</body>
</html>
