{
	"$schema": "node_modules/wrangler/config-schema.json",
	"account_id": "1dc7f5dfd6f1830ea5b903d051c6d624",
	"compatibility_date": "2026-04-08",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "./src/worker.ts",
	"name": "spacestars",
	"assets": {
		"binding": "ASSETS"
	},
	"workers_dev": true,
	"preview_urls": true,
	"images": {
		"binding": "IMAGES",
		"remote": true
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"observability": {
		"logs": {
			"enabled": true,
			"invocation_logs": true,
			"head_sampling_rate": 1,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 1,
			"persist": true
		}
	},
	"limits": {
		"cpu_ms": 60000
	},
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "7fd1c42ad9414b3780b73dc22a7023a9"
		}
	],
	"upload_source_maps": true
}